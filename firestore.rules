rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: mural_posts
    // Fields: id, title, content, image, date, author
    //
    // Collection: documents
    // Fields: id, title, type, status, uploader, uploadDate, area, expirationDate
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasEmail(email) {
      return isAuthenticated() && 
             'token' in request.auth && 
             'email' in request.auth.token && 
             request.auth.token.email == email;
    }

    function isAdmin() {
      return isAuthenticated() && 
             'token' in request.auth && 
             'email' in request.auth.token && (
               request.auth.token.email == "juliana.engbio@gmail.com" ||
               request.auth.token.email == "rafael.dias@eclin.eng.br" ||
               request.auth.token.email == "qualidade@eclin.com.br" ||
               request.auth.token.email == "marketing@grupoeclin.com.br"
             );
    }

    function isValidMuralPost(data) {
      return data.keys().hasAll(['title', 'content', 'date']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000;
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['title', 'type', 'status', 'uploader', 'uploadDate']) &&
             data.title is string && data.title.size() > 0 &&
             data.type in ['pdf', 'doc', 'docx'] &&
             data.status in ['published', 'review', 'pending', 'signed', 'approved', 'rejected'] &&
             (!('area' in data) || data.area is string) &&
             (!('expirationDate' in data) || data.expirationDate is string);
    }

    // Rules
    match /mural_posts/{postId} {
      allow read: if true;
      // TEMPORÁRIO: Permitindo escrita pública para contornar erro de permissão (auth/admin-restricted-operation)
      // Recomendação: Ativar "Anonymous Auth" no Console do Firebase e restaurar "if isAuthenticated()"
      allow create, update, delete: if true; 
    }

    match /documents/{docId} {
      allow read: if true;
      // TEMPORÁRIO: Permitindo escrita pública para contornar erro de permissão (auth/admin-restricted-operation)
      // Recomendação: Ativar "Anonymous Auth" no Console do Firebase e restaurar "if isAuthenticated()"
      allow create, update, delete: if true;
    }

    match /collaborators/{email} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /quality_logs/{logId} {
      allow read: if isAdmin() || hasEmail("juliana.engbio@gmail.com") || hasEmail("qualidade@eclin.com.br");
      allow create: if true;
      allow update, delete: if false; // Os logs de auditoria são imutáveis e protegidos contra remoção/edição
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
